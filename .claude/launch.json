{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", ". \"$HOME/.nvm/nvm.sh\" && npm --prefix backend start"],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", ". \"$HOME/.nvm/nvm.sh\" && npm --prefix frontend run dev -- --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
